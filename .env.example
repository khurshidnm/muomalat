# Copy to .env for local development: cp .env.example .env
# Then replace the <generate> values:  openssl rand -base64 64 | tr -d '\n'
SITE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
CMS_URL=http://cms.localhost:3000
SITE_HOST=localhost:3000
CMS_HOST=cms.localhost:3000
# How the worker reaches the app's /internal/revalidate. Not the site or CMS
# host (the proxy 404s /internal there); http://app:3000 in production.
INTERNAL_APP_URL=http://127.0.0.1:3000

# Data-only role for the app; owner role only for migrations (docker/compose.dev.yml)
DATABASE_URL=postgres://muomalat_app:dev-app-password@127.0.0.1:5432/muomalat
DATABASE_URL_MIGRATE=postgres://muomalat_owner:dev-owner-password@127.0.0.1:5432/muomalat

PAYLOAD_SECRET=<generate>
# Shared by the app and the worker (HMAC of /internal/revalidate, at least 32 bytes)
INTERNAL_REVALIDATE_SECRET=<generate>
MEDIA_DIR=./.data/media

# Cloudflare Access (CMS-SPEC §12.2): required in production and staging
ACCESS_JWT_REQUIRED=false
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Emergency read-only switch (§12.10): 1 refuses every staff write
CMS_READ_ONLY=
# Cloudflare purge (worker only; empty = nothing is purged, one log line)
CF_API_TOKEN=
CF_ZONE_ID=

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=dev@muomalat.local

# Staff alerts and workflow notices (§9.3, §10.9): the private staff group.
# Empty = logged only; e-mail goes to site-settings → Ishlash → Ogohlantirish oluvchilar
ALERTS_BOT_TOKEN=
ALERTS_CHAT_ID=
# ALERTS_EMAIL=off
# Nightly audit export (§9.3): a directory, or s3://bucket/prefix with write-only keys
AUDIT_EXPORT_TARGET=./.data/audit-export
AUDIT_S3_ENDPOINT=
AUDIT_S3_REGION=
AUDIT_S3_ACCESS_KEY_ID=
AUDIT_S3_SECRET_ACCESS_KEY=
# AUDIT_NIGHTLY_AT=02:30
# AUDIT_ALERTS_INTERVAL_MS=10000
# Production and staging: a missing ops.backup_ok by 06:00 raises ops.backup_fail
# BACKUP_EXPECTED=true

CONTENT_SOURCE=mock
