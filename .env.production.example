# Production settings for docker/compose.prod.yml (CMS-SPEC §2.5, §12.6).
#
# On the VPS this file lives at /etc/muomalat/muomalat.env, owned by root with
# mode 0600, and never goes into Git. Compose reads it with --env-file and
# hands each container only the variables it needs (see the compose file).
# Staging gets its own file with its own secrets; never reuse production's.
#
# Generate secrets on the VPS, one per line, and paste them in:
#   database passwords (letters and digits, safe inside a URL):  openssl rand -hex 32
#   PAYLOAD_SECRET (at least 64 bytes):                          openssl rand -base64 64 | tr -d '\n'
#   INTERNAL_REVALIDATE_SECRET (at least 32 bytes):              openssl rand -base64 32
# Do not use the character $ in any value (Compose would read it as a variable).
#
# Every line below is needed unless it says "optional".

# ── Images (from CI: GitHub Actions → the run's summary lists both digests) ──
# Deploy by digest, never by a moving tag. The previous digests are your rollback.
MUOMALAT_IMAGE=ghcr.io/khurshidnm/muomalat@sha256:<digest>
MUOMALAT_BACKUP_IMAGE=ghcr.io/khurshidnm/muomalat-backup@sha256:<digest>

# ── Site and hosts ────────────────────────────────────────────────────────
# production | staging. Production refuses to start on any unsafe setting (§12.1).
SITE_ENV=production
# Public site origin (canonical URLs, purge URLs, links in e-mails)
SITE_URL=https://muomalat.uz
# CMS origin, behind Cloudflare Access (Payload serverURL, CSRF and CORS allow-list)
CMS_URL=https://cms.muomalat.uz
# Host headers the app answers as the site and as the CMS (src/proxy.ts)
SITE_HOST=muomalat.uz
CMS_HOST=cms.muomalat.uz

# ── Database (docker/postgres/init creates the roles on first start) ──────
# Superuser, used only inside the postgres container (no network login)
POSTGRES_SUPERUSER_PASSWORD=<openssl rand -hex 32>
# Schema owner: the migrate job only
OWNER_DB_PASSWORD=<openssl rand -hex 32>
# Data-only role: app, worker, and the backup's audit row
APP_DB_PASSWORD=<openssl rand -hex 32>
# Read-only role: pg_dump in the backup service
BACKUP_DB_PASSWORD=<openssl rand -hex 32>

# ── App secrets ───────────────────────────────────────────────────────────
# Signs CMS sessions and form tokens. Changing it logs everyone out: rotate it
# when someone with server access leaves (docs/RUNBOOKS.md).
PAYLOAD_SECRET=<openssl rand -base64 64 | tr -d '\n'>
# HMAC key between the worker and the app's /internal/revalidate
INTERNAL_REVALIDATE_SECRET=<openssl rand -base64 32>

# ── Cloudflare ────────────────────────────────────────────────────────────
# Tunnel token: Zero Trust → Networks → Tunnels → muomalat → install connector (the long eyJ… string)
CLOUDFLARE_TUNNEL_TOKEN=<tunnel token>
# The CMS checks every request's Access JWT; must be true in production.
ACCESS_JWT_REQUIRED=true
# Zero Trust → Settings → Team name and domain, e.g. muomalat.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# Access → Applications → cms.muomalat.uz → Overview → Application Audience (AUD) Tag
CF_ACCESS_AUD=<aud tag>
# Cache purge after each publish (worker). Token with Zone → Cache Purge on this
# zone only; Zone ID from the zone's Overview page. Optional: empty = no purge.
CF_API_TOKEN=
CF_ZONE_ID=

# ── Emergency ─────────────────────────────────────────────────────────────
# 1 = read-only: every CMS write is refused, the scheduler and Telegram pause,
# the site keeps serving (§12.10). Empty in normal operation.
CMS_READ_ONLY=

# ── E-mail (password resets, digest confirmations, alerts) ────────────────
# An EU-region SMTP provider; port 587 with STARTTLS (required in production)
SMTP_HOST=<smtp.provider.eu>
SMTP_PORT=587
SMTP_USER=<user>
SMTP_PASS=<password>
MAIL_FROM=noreply@muomalat.uz

# ── Staff alerts (§9.3) ───────────────────────────────────────────────────
# A separate bot from the publishing bot, in the private staff alerts group.
# Optional but strongly recommended: empty = alerts only in the worker log and by e-mail.
ALERTS_BOT_TOKEN=
ALERTS_CHAT_ID=
# off = no alert e-mails (recipients are set in the CMS: site settings → Ishlash). Optional.
ALERTS_EMAIL=

# ── Telegram publishing (Phase 2). Optional until then. ───────────────────
# Production must use @muomalatuz; staging a private test channel and its own bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=

# ── Nightly audit export (§9.3) to the backup bucket (object lock) ────────
# s3://<bucket>/<prefix>, with a key that can only write under that prefix
AUDIT_EXPORT_TARGET=s3://<bucket>/audit/production
AUDIT_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
AUDIT_S3_REGION=eu-central-003
AUDIT_S3_ACCESS_KEY_ID=<write-only key id>
AUDIT_S3_SECRET_ACCESS_KEY=<write-only key>
# Tashkent time of the export. Optional.
AUDIT_NIGHTLY_AT=02:30

# ── Backups (§12.7, docker/backup) ────────────────────────────────────────
# Tashkent time of the nightly run
BACKUP_AT=01:30
# age public keys (age1…), space separated; the private keys stay offline.
# Two recommended: yours and one kept in the office safe.
BACKUP_AGE_RECIPIENTS=<age1… age1…>
# S3-compatible EU bucket with object lock (30 days) and lifecycle rules (docs/DEPLOY.md)
# rclone provider name; Other works for Backblaze B2 and most others
BACKUP_S3_PROVIDER=Other
BACKUP_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
BACKUP_S3_REGION=eu-central-003
BACKUP_S3_BUCKET=<bucket>
# Folder in the bucket; daily/, weekly/ and monthly/ go under it
BACKUP_S3_PREFIX=production
# A key that can only write (no list, read or delete) under that prefix
BACKUP_S3_ACCESS_KEY_ID=<write-only key id>
BACKUP_S3_SECRET_ACCESS_KEY=<write-only key>
# true for most providers; false only if yours needs virtual-hosted URLs. Optional.
BACKUP_S3_PATH_STYLE=true
# Advanced, optional: a full rclone destination instead of store:<bucket>/<prefix>
BACKUP_REMOTE=
# Days of encrypted copies kept on the VPS for quick restores. Optional.
BACKUP_KEEP_LOCAL=3
# true = the backup deletes old copies itself; only for a bucket without
# lifecycle rules, and the key must then list and delete. Optional.
BACKUP_PRUNE=false
# A missing ops.backup_ok by 06:00 raises an alert (worker). Optional.
BACKUP_EXPECTED=true

# ── Restores only (docs/RUNBOOKS.md). Leave empty the rest of the time. ───
# A key that can list and read the backup prefix; create it for the restore, delete it after.
RESTORE_S3_ACCESS_KEY_ID=
RESTORE_S3_SECRET_ACCESS_KEY=

# ── Optional ──────────────────────────────────────────────────────────────
# off = hide the demo notice in the header whatever the CMS says (kept as a hard override)
NEXT_PUBLIC_DEMO_NOTICE=
