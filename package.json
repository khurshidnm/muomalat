{
  "name": "muomalat",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/gen-images.mjs",
    "validate": "tsx scripts/validate-content.ts",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "db:up": "docker compose -f docker/compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker/compose.dev.yml down",
    "admin:create": "tsx --env-file=.env scripts/create-first-admin.ts",
    "db:migrate": "DB_ROLE=owner payload migrate",
    "db:migrate:create": "DB_ROLE=owner payload migrate:create",
    "db:migrate:status": "DB_ROLE=owner payload migrate:status",
    "worker": "tsx --env-file=.env src/worker/index.ts",
    "test": "vitest run",
    "test:db": "scripts/test-db.sh"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "bson-objectid": "2.0.4",
    "graphql": "16.14.2",
    "jose": "5.10.0",
    "next": "16.4.0",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "undici": "7.30.0",
    "dompurify": "3.4.16",
    "nodemailer": "10.0.10"
  }
}
